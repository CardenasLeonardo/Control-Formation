<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Argumento namespace, se puede sobreescribir desde el include -->
    <xacro:arg name="namespace" default="robot0"/>
    
    <!-- Convertir argumento a propiedad para usarla en el plugin -->
    <xacro:property name="namespace" value="$(arg namespace)"/>

    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">

            <ros>
                <!-- Namespace para multi-robot -->
                <namespace>${namespace}</namespace>
                <!-- Remaps opcionales -->
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>

            <!-- Wheel Information - ahora con namespace -->
            <left_joint>${namespace}/left_wheel_joint</left_joint>
            <right_joint>${namespace}/right_wheel_joint</right_joint>
            <wheel_separation>0.35</wheel_separation>
            <wheel_diameter>0.1</wheel_diameter>

            <!-- Limits -->
            <max_wheel_torque>200</max_wheel_torque>
            <max_wheel_acceleration>10.0</max_wheel_acceleration>

            <!-- Output frames - ahora con namespace -->
            <odometry_frame>${namespace}/odom</odometry_frame>
            <robot_base_frame>${namespace}/base_link</robot_base_frame>

            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>

        </plugin>
    </gazebo>

</robot>