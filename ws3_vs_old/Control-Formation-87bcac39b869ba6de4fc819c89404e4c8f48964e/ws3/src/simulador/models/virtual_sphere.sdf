<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="virtual_sphere">
    <static>false</static>
    <link name="link">
      <kinematic>true</kinematic>   <!-- no le afecta la gravedad ni las fuerzas -->
      <visual name="visual">
        <transparency>0.5</transparency>   <!-- 0=opaco, 1=invisible -->
        <geometry>
          <sphere><radius>0.20</radius></sphere>
        </geometry>
        <material>
          <ambient>0.0 0.6 1.0 1.0</ambient>
          <diffuse>0.0 0.6 1.0 1.0</diffuse>
        </material>
      </visual>
      <!-- sin <collision>: los robots la atraviesan -->
    </link>
  </model>
</sdf>
