<?xml version="1.0"?>
<sdf version="1.6">
  <model name="overhead_camera">
    <static>false</static>
    <link name="link">
      <kinematic>true</kinematic>
      <sensor name="overhead_camera_sensor" type="camera">
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>1280</width>
            <height>1280</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="overhead_camera_controller" filename="libgazebo_ros_camera.so">
          <camera_name>overhead_camera</camera_name>
          <frame_name>overhead_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
