digraph SystemSDL {
    rankdir=TB;
    compound=true;
    bgcolor="white";
    fontname="Times New Roman";
    fontsize=12;
    label="System SDL Diagram - Multi-Robot Formation Control";
    labelloc=t;
    pad=0.5;

    edge [fontname="Times New Roman", fontsize=9];

    node [shape=box, style="filled,rounded", penwidth=2, color="#1A237E",
          fillcolor="#E8F0FE", fontname="Times New Roman", fontsize=11,
          width=2.0, height=1.2];

    GAZEBO [label="Gazebo Simulator\nPhysical Simulation\nDynamics + Collision\nLIDAR Raycasting"];

    subgraph cluster_robots {
        label="Robot Nodes (N instances)";
        style=dashed;
        fontname="Times New Roman";
        fontsize=11;
        color="#666666";
        pencolor="#666666";

        node [width=1.8, height=1.0];

        ROBOT0 [label="Robot 0 (Leader)\nNavigateWaypoints\n+ PVA", fillcolor="#E8F5E9"];
        ROBOT1 [label="Robot 1 (Follower)\nConsensusLeader\n+ PVA", fillcolor="#FFF3E0"];
        ROBOT2 [label="Robot 2 (Follower)\nConsensusLeader\n+ PVA", fillcolor="#FFF3E0"];
        ROBOTN [label="Robot N-1 (Follower)\nConsensusLeader\n+ PVA", fillcolor="#FFF3E0"];
    }

    AIRE [label="AIRE Node\nNeighbor Router\nDisk Graph Topology", fillcolor="#F3E5F5"];
    PLOTTER [label="States Plotter V2\nData Logger\nTrajectory Plot", fillcolor="#FFFDE7"];

    GAZEBO -> ROBOT0 [label="odom (Odometry)\nscan (LaserScan)"];
    GAZEBO -> ROBOT1 [label="odom (Odometry)\nscan (LaserScan)"];
    GAZEBO -> ROBOT2 [label="odom (Odometry)\nscan (LaserScan)"];
    GAZEBO -> ROBOTN [label="odom (Odometry)\nscan (LaserScan)"];

    ROBOT0 -> AIRE [label="robot_states_tx (RobotState)"];
    ROBOT1 -> AIRE [label="robot_states_tx (RobotState)"];
    ROBOT2 -> AIRE [label="robot_states_tx (RobotState)"];
    ROBOTN -> AIRE [label="robot_states_tx (RobotState)"];

    AIRE -> ROBOT0 [label="robot0/neighbors_rx (RobotState)"];
    AIRE -> ROBOT1 [label="robot1/neighbors_rx (RobotState)"];
    AIRE -> ROBOT2 [label="robot2/neighbors_rx (RobotState)"];
    AIRE -> ROBOTN [label="robotN-1/neighbors_rx (RobotState)"];

    ROBOT0 -> GAZEBO [label="cmd_vel (Twist)"];
    ROBOT1 -> GAZEBO [label="cmd_vel (Twist)"];
    ROBOT2 -> GAZEBO [label="cmd_vel (Twist)"];
    ROBOTN -> GAZEBO [label="cmd_vel (Twist)"];

    ROBOT0 -> PLOTTER [label="robot_states_plot (RobotState)"];
    ROBOT1 -> PLOTTER [label="robot_states_plot (RobotState)"];
    ROBOT2 -> PLOTTER [label="robot_states_plot (RobotState)"];
    ROBOTN -> PLOTTER [label="robot_states_plot (RobotState)", style=dashed];
}
