digraph AireProcessSDL {
    rankdir=TB;
    bgcolor="white";
    fontname="Times New Roman";
    fontsize=12;
    label="Process SDL Diagram - AIRE Node (Neighbor Router)";
    labelloc=t;
    pad=0.5;
    nodesep=0.4;
    ranksep=0.5;

    edge [fontname="Times New Roman", fontsize=9, color="#333333"];

    node [shape=box, style="filled", fillcolor="#FAFAFA",
          penwidth=1.5, color="#333333", fontname="Times New Roman", fontsize=10];

    "START" [label="START\nNode Initialization", shape=box, style=rounded, fillcolor="#E8F0FE",
             penwidth=2, color="#1A237E", fontsize=11, width=1.8];
    "INIT" [label="Declare Parameter:\nneighbor_radius (R)\n\nInitialize:\nstates = {}\npublishers = {}\n\nCreate Subscriber:\n/robot_states_tx\n\nWait for signals..."];
    "START" -> "INIT";

    subgraph cluster_main {
        label="Process: state_callback";
        style=rounded;
        fontname="Times New Roman";
        fontsize=11;
        color="#333333";
        pencolor="#333333";

        node [fontname="Times New Roman", fontsize=10];

        "RX_MSG" [label="Receive RobotState\nrobot_id, x, y, theta", shape=parallelogram, style=filled, fillcolor="#E8F5E9",
                  penwidth=1.5, color="#2E7D32"];
        "UPDATE_STATE" [label="Update global state:\nstates[msg.robot_id] = (x, y, theta)\n\nEnsure publisher exists"];
        "FOREACH_R" [label="FOR EACH known robot r_i\nin states:", shape=box, style=filled, fillcolor="#F3E5F5",
                     penwidth=1.5, color="#6A1B9A"];
        "GET_PUB" [label="Get publisher for r_i"];
        "FOREACH_N" [label="FOR EACH neighbor candidate r_j\nin states:", shape=box, style=filled, fillcolor="#F3E5F5",
                     penwidth=1.5, color="#6A1B9A"];
        "IS_SELF" [label="r_j == r_i?\n(same robot?)", shape=diamond, style=filled, fillcolor="#FFF9C4",
                   penwidth=1.5, color="#F57F17", width=1.5, height=0.9];
        "COMPUTE_DIST" [label="Compute distance:\nd = sqrt((x_j - x_i)^2 + (y_j - y_i)^2)"];
        "IS_NEIGHBOR" [label="d <= R?\n(within radius?)", shape=diamond, style=filled, fillcolor="#FFF9C4",
                       penwidth=1.5, color="#F57F17", width=1.5, height=0.9];
        "PUB_NEIGHBOR" [label="Publish RobotState\n-> {r_i}/neighbors_rx\n(containing r_j data)", shape=parallelogram, style=filled, fillcolor="#FFF3E0",
                        penwidth=1.5, color="#E65100"];
        "NEXT_N" [label="NEXT r_j"];
        "NEXT_R" [label="NEXT r_i"];
        "DONE" [label="RETURN\n(wait for next signal)", shape=box, style=rounded, fillcolor="#E8F0FE",
                penwidth=2, color="#1A237E", width=1.5];

        "RX_MSG" -> "UPDATE_STATE" -> "FOREACH_R";
        "FOREACH_R" -> "GET_PUB";
        "GET_PUB" -> "FOREACH_N";
        "FOREACH_N" -> "IS_SELF";
        "IS_SELF" -> "NEXT_N" [label="Yes (skip)", color="#C62828"];
        "IS_SELF" -> "COMPUTE_DIST" [label="No", color="#2E7D32"];
        "COMPUTE_DIST" -> "IS_NEIGHBOR";
        "IS_NEIGHBOR" -> "PUB_NEIGHBOR" [label="Yes", color="#2E7D32"];
        "IS_NEIGHBOR" -> "NEXT_N" [label="No", color="#C62828"];
        "PUB_NEIGHBOR" -> "NEXT_N";
        "NEXT_N" -> "NEXT_R";
        "NEXT_R" -> "DONE";
    }
}
