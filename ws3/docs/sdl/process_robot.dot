digraph RobotProcessSDL {
    rankdir=TB;
    bgcolor="white";
    fontname="Times New Roman";
    fontsize=12;
    label="Process SDL Diagram - Robot Control Node";
    labelloc=t;
    pad=0.5;
    nodesep=0.4;
    ranksep=0.4;

    edge [fontname="Times New Roman", fontsize=9, color="#333333"];

    node [shape=box, style="filled", fillcolor="#FAFAFA",
          penwidth=1.5, color="#333333", fontname="Times New Roman", fontsize=10];

    "START" [label="START\nNode Initialization", shape=box, style=rounded, fillcolor="#E8F0FE",
                penwidth=2, color="#1A237E", fontsize=11, width=1.8];

    "INIT" [label="Declare Parameters\nleader_id, vmax, wmax, k1, k2\n\nInitialize State Variables\nx=0, y=0, theta=0\nneighbors={}, ranges=[]\n\nCreate Subscribers:\nodom, scan, neighbors_rx\n\nCreate Publishers:\nrobot_states_tx, cmd_vel\npva_constraints, robot_states_plot\n\nCreate Timer (0.1s = 10 Hz)\n-> control_loop()"];

    "START" -> "INIT";

    subgraph cluster_odom_cb {
        label="Signal Handler: odom (Odometry)";
        style=rounded;
        fontname="Times New Roman";
        fontsize=11;
        color="#1565C0";
        pencolor="#1565C0";

        node [fontname="Times New Roman", fontsize=10];

        "ODOM_RX" [label="odom Callback", shape=parallelogram, style=filled, fillcolor="#E8F5E9",
                   penwidth=1.5, color="#2E7D32"];
        "ODOM_EXTRACT" [label="Extract pose:\nx = msg.pose.pose.position.x\ny = msg.pose.pose.position.y\ntheta = atan2(q.w*z + q.x*y,\n  1 - 2(y^2 + z^2))"];
        "ODOM_PUB_STATE" [label="Publish RobotState\n-> /robot_states_tx\n-> /robot_states_plot", shape=parallelogram, style=filled, fillcolor="#FFF3E0",
                          penwidth=1.5, color="#E65100"];
        "ODOM_END" [label="RETURN", shape=box, style=rounded, fillcolor="#E8F0FE",
                    penwidth=2, color="#1A237E", width=1.2];

        "ODOM_RX" -> "ODOM_EXTRACT" -> "ODOM_PUB_STATE" -> "ODOM_END";
    }

    subgraph cluster_scan_cb {
        label="Signal Handler: scan (LaserScan)";
        style=rounded;
        fontname="Times New Roman";
        fontsize=11;
        color="#1565C0";
        pencolor="#1565C0";

        node [fontname="Times New Roman", fontsize=10];

        "SCAN_RX" [label="scan Callback", shape=parallelogram, style=filled, fillcolor="#E8F5E9",
                   penwidth=1.5, color="#2E7D32"];
        "SCAN_STORE" [label="Store ranges:\nself.ranges = list(msg.ranges)"];
        "SCAN_END" [label="RETURN", shape=box, style=rounded, fillcolor="#E8F0FE",
                    penwidth=2, color="#1A237E", width=1.2];

        "SCAN_RX" -> "SCAN_STORE" -> "SCAN_END";
    }

    subgraph cluster_neighbor_cb {
        label="Signal Handler: neighbors_rx (RobotState)";
        style=rounded;
        fontname="Times New Roman";
        fontsize=11;
        color="#1565C0";
        pencolor="#1565C0";

        node [fontname="Times New Roman", fontsize=10];

        "NEIGH_RX" [label="neighbors_rx Callback", shape=parallelogram, style=filled, fillcolor="#E8F5E9",
                    penwidth=1.5, color="#2E7D32"];
        "NEIGH_STORE" [label="Store neighbor state:\nself.neighbors[msg.robot_id]\n  = (msg.x, msg.y, msg.theta)"];
        "NEIGH_END" [label="RETURN", shape=box, style=rounded, fillcolor="#E8F0FE",
                     penwidth=2, color="#1A237E", width=1.2];

        "NEIGH_RX" -> "NEIGH_STORE" -> "NEIGH_END";
    }

    subgraph cluster_control_loop {
        label="Process: control_loop (every 0.1s)";
        style=rounded;
        fontname="Times New Roman";
        fontsize=11;
        color="#333333";
        pencolor="#333333";

        node [fontname="Times New Roman", fontsize=10];

        "CL_START" [label="control_loop()", shape=box, style=rounded, fillcolor="#E8F0FE",
                    penwidth=2, color="#1A237E", width=1.5];
        "CL_SYNC" [label="Sync: All robots ready?\n(known_robots >= n_expected)", shape=diamond, style=filled, fillcolor="#FFF9C4",
                   penwidth=1.5, color="#F57F17", width=1.6, height=1.0];
        "CL_INIT" [label="Initialize state:\nself_state = (x, y, theta)\nneighbors = [(xj, yj) ...]"];
        "CL_CONSENSUS" [label="Compute Consensus:\nv_goal, w_goal = algorithm.compute(\n  self_state, neighbors)", shape=box, style=filled, fillcolor="#F3E5F5",
                        penwidth=1.5, color="#6A1B9A"];
        "CL_HAS_LIDAR" [label="LIDAR data available?\n(len(ranges) > 0)", shape=diamond, style=filled, fillcolor="#FFF9C4",
                        penwidth=1.5, color="#F57F17", width=1.6, height=1.0];
        "CL_BUILD_PVA" [label="Build PVA Constraints:\nconstraints = pva.build_constraints(ranges)\n\nSolve QP:\nv_safe, w_safe = pva.solve_qp(\n  v_goal, w_goal, constraints)", shape=box, style=filled, fillcolor="#F3E5F5",
                        penwidth=1.5, color="#6A1B9A"];
        "CL_NO_PVA" [label="No LIDAR:\nv_safe = v_goal\nw_safe = w_goal"];
        "CL_PUB_PVA" [label="Publish PVAConstraints\n-> /pva_constraints", shape=parallelogram, style=filled, fillcolor="#FFF3E0",
                      penwidth=1.5, color="#E65100"];
        "CL_PUB_VEL" [label="Publish cmd_vel:\ntwist.linear.x = v_safe\ntwist.angular.z = w_safe", shape=parallelogram, style=filled, fillcolor="#FFF3E0",
                      penwidth=1.5, color="#E65100"];
        "CL_END" [label="RETURN (next tick)", shape=box, style=rounded, fillcolor="#E8F0FE",
                  penwidth=2, color="#1A237E", width=1.5];

        "CL_START" -> "CL_SYNC";
        "CL_SYNC" -> "CL_INIT" [label="Yes", color="#2E7D32"];
        "CL_SYNC" -> "CL_END" [label="No, wait", color="#C62828"];
        "CL_INIT" -> "CL_CONSENSUS";
        "CL_CONSENSUS" -> "CL_HAS_LIDAR";
        "CL_HAS_LIDAR" -> "CL_BUILD_PVA" [label="Yes", color="#2E7D32"];
        "CL_HAS_LIDAR" -> "CL_NO_PVA" [label="No", color="#C62828"];
        "CL_BUILD_PVA" -> "CL_PUB_PVA";
        "CL_NO_PVA" -> "CL_PUB_PVA";
        "CL_PUB_PVA" -> "CL_PUB_VEL";
        "CL_PUB_VEL" -> "CL_END";
    }
}
