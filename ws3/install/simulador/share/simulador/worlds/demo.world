<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <!-- Fondo de la escena en blanco, sin sombras: junto con el suelo sin
         visual (abajo), la cámara cenital solo capta los robots "flotando"
         sobre blanco, para que combine con el fondo de la diapositiva. -->
    <scene>
      <background>1 1 1 1</background>
      <shadows>false</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <!-- Solo colisión: los robots necesitan una superficie física donde
             pararse y manejar, pero no se le da <visual> para que no se vea
             (queda transparente, se ve el fondo blanco de la escena). -->
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    <include><uri>model://sun</uri></include>

    <!-- Plugin que expone /gazebo/set_entity_state para mover modelos -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

  </world>
</sdf>
